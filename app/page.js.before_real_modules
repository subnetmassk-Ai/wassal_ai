function ContactsPage() {
  const defaultContacts = [
    { id: 1, name: "Ahmad Hassan", phone: "+96170123456", email: "ahmad@example.com", company: "Hassan Trading", conversations: 12, lastContact: "1 min ago", channel: "WhatsApp", status: "Active" },
    { id: 2, name: "Sara Khalil", phone: "+96171234567", email: "sara@example.com", company: "Khalil Design", conversations: 8, lastContact: "3 min ago", channel: "WhatsApp", status: "Active" },
    { id: 3, name: "Omar Nasser", phone: "+96176345678", email: "omar@example.com", company: "Nasser Group", conversations: 6, lastContact: "7 min ago", channel: "Voice", status: "Active" },
    { id: 4, name: "Lina Haddad", phone: "+96178456789", email: "lina@example.com", company: "Haddad Store", conversations: 15, lastContact: "18 min ago", channel: "WhatsApp", status: "Active" },
    { id: 5, name: "Karim Saleh", phone: "+96179567890", email: "karim@example.com", company: "Saleh Services", conversations: 4, lastContact: "32 min ago", channel: "Voice", status: "Active" },
  ];

  const [contacts, setContacts] = useState(() => {
    if (typeof window === "undefined") return defaultContacts;
    try {
      const saved = localStorage.getItem("wassal_contacts");
      const parsed = saved ? JSON.parse(saved) : null;
      return Array.isArray(parsed) ? parsed : defaultContacts;
    } catch {
      return defaultContacts;
    }
  });

  const [selectedId, setSelectedId] = useState(1);
  const [search, setSearch] = useState("");
  const [showAdd, setShowAdd] = useState(false);
  const [form, setForm] = useState({
    name: "",
    phone: "",
    email: "",
    company: "",
  });

  useEffect(() => {
    if (typeof window !== "undefined") {
      try {
        localStorage.setItem("wassal_contacts", JSON.stringify(contacts));
      } catch (error) {
        console.warn("Could not save contacts:", error);
      }
    }
  }, [contacts]);

  const filtered = contacts.filter((c) => {
    const q = search.toLowerCase().trim();
    if (!q) return true;
    return (
      String(c.name || "").toLowerCase().includes(q) ||
      String(c.phone || "").toLowerCase().includes(q) ||
      String(c.email || "").toLowerCase().includes(q) ||
      String(c.company || "").toLowerCase().includes(q)
    );
  });

  const selected =
    contacts.find((c) => c.id === selectedId) ||
    filtered[0] ||
    contacts[0] ||
    defaultContacts[0];


  async function importPhoneContacts() {
    try {
      if (!navigator.contacts || !navigator.contacts.select) {
        alert("Phone contact access is not supported here. Try Chrome on Android.");
        return;
      }

      const picked = await navigator.contacts.select(
        ["name", "tel", "email"],
        { multiple: true }
      );

      if (!picked || !picked.length) return;

      const imported = picked
        .map((item, index) => {
          const name = Array.isArray(item.name) ? item.name[0] : item.name;
          const phone = Array.isArray(item.tel) ? item.tel[0] : item.tel;
          const email = Array.isArray(item.email) ? item.email[0] : item.email;

          if (!phone) return null;

          return {
            id: Date.now() + index,
            name: name || "Phone contact",
            phone,
            email: email || "—",
            company: "Phone contact",
            conversations: 0,
            lastContact: "Just now",
            channel: "WhatsApp",
            status: "Active",
          };
        })
        .filter(Boolean);

      if (!imported.length) {
        alert("No phone numbers were found.");
        return;
      }

      setContacts((old) => {
        const existing = new Set(
          old.map((c) => String(c.phone || "").replace(/\D/g, ""))
        );

        const fresh = imported.filter((c) => {
          const number = String(c.phone || "").replace(/\D/g, "");
          return number && !existing.has(number);
        });

        return [...fresh, ...old];
      });

      setSelectedId(imported[0].id);
    } catch (error) {
      if (error?.name !== "AbortError") {
        console.error(error);
        alert("Could not access phone contacts.");
      }
    }
  }

  function newConversation(phone) {
    const number = String(phone || "").replace(/\D/g, "");

    if (!number) {
      alert("Invalid phone number.");
      return;
    }

    window.location.href = "https://wa.me/" + number;
  }

  function saveContact() {
    const name = form.name.trim();
    const phone = form.phone.trim();

    if (!name || !phone) {
      alert("Please enter a name and phone number.");
      return;
    }

    const contact = {
      id: Date.now(),
      name,
      phone,
      email: form.email.trim() || "—",
      company: form.company.trim() || "—",
      conversations: 0,
      lastContact: "Just now",
      channel: "WhatsApp",
      status: "Active",
    };

    setContacts((old) => [contact, ...old]);
    setSelectedId(contact.id);
    setForm({ name: "", phone: "", email: "", company: "" });
    setShowAdd(false);
  }

  function openWhatsApp(phone) {
    const number = String(phone || "").replace(/\D/g, "");
    if (!number) return alert("Invalid phone number.");
    window.open("https://wa.me/" + number, "_blank");
  }

  function startCall(phone) {
    const number = String(phone || "").replace(/[^\d+]/g, "");
    if (!number) return alert("Invalid phone number.");
    window.location.href = "tel:" + number;
  }

  if (!selected) {
    return (
      <div className="page contacts-page">
        <div className="contacts-toolbar">
          <div>
            <div className="eyebrow">CUSTOMER DIRECTORY</div>
            <h2>Contacts</h2>
            <p>Manage your customers and communication details.</p>
          </div>
          <button className="primary" onClick={() => setShowAdd(true)}>
            + Add contact
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="page contacts-page">
      <div className="contacts-toolbar">
        <div>
          <div className="eyebrow">CUSTOMER DIRECTORY</div>
          <h2>Contacts</h2>
          <p>Manage your customers and communication details.</p>
        </div>

        <div className="contacts-toolbar-buttons">
          <button className="primary" onClick={importPhoneContacts}>
            📱 Choose phone contacts
          </button>

          <button className="secondary" onClick={() => setShowAdd(true)}>
            + Add contact
          </button>
        </div>
      </div>

      {showAdd && (
        <div className="card add-contact-panel">
          <strong>Add a new contact</strong>

          <div className="add-contact-grid">
            <input
              value={form.name}
              onChange={(e) => setForm({ ...form, name: e.target.value })}
              placeholder="Name *"
            />
            <input
              value={form.phone}
              onChange={(e) => setForm({ ...form, phone: e.target.value })}
              placeholder="Phone *"
              type="tel"
            />
            <input
              value={form.email}
              onChange={(e) => setForm({ ...form, email: e.target.value })}
              placeholder="Email"
              type="email"
            />
            <input
              value={form.company}
              onChange={(e) => setForm({ ...form, company: e.target.value })}
              placeholder="Company"
            />
          </div>

          <div className="add-contact-buttons">
            <button className="primary" onClick={saveContact}>
              Save contact
            </button>
            <button className="secondary" onClick={() => setShowAdd(false)}>
              Cancel
            </button>
          </div>
        </div>
      )}

      <div className="contacts-layout">
        <section className="card contacts-list">
          <div className="contacts-list-head">
            <div className="conversation-search">
              <span>⌕</span>
              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search contacts..."
              />
            </div>
            <div className="contacts-count">{filtered.length} contacts</div>
          </div>

          <div className="contact-items">
            {filtered.map((contact) => (
              <button
                key={contact.id}
                className={
                  selectedId === contact.id
                    ? "contact-item selected"
                    : "contact-item"
                }
                onClick={() => setSelectedId(contact.id)}
              >
                <div className="contact-avatar">
                  {(contact.name || "?").charAt(0).toUpperCase()}
                </div>
                <div className="contact-main">
                  <div className="contact-name-row">
                    <strong>{contact.name}</strong>
                    <span>{contact.lastContact}</span>
                  </div>
                  <p>{contact.phone}</p>
                  <div className="contact-meta">
                    <span className="channel-tag">
                      ◉ {contact.channel}
                    </span>
                    <span className="conversation-number">
                      {contact.conversations} conversations
                    </span>
                  </div>
                </div>
              </button>
            ))}

            {!filtered.length && (
              <div className="empty-conversations">
                <strong>No contacts found</strong>
                <p>Try another name or phone number.</p>
              </div>
            )}
          </div>
        </section>

        <section className="card contact-detail">
