    </div>
  );
}

function Conversation({ letter, name, time }) {
  return (
    <div className="row">
      <div className="avatar-small">{letter}</div>

      <div className="row-info">
        <b>{name}</b>
        <small>{time}</small>
      </div>

      <span className="pill">Resolved</span>
    </div>
  );
}


function ConversationsPage() {
  const [conversations, setConversations] = useState([]);
  const [selectedId, setSelectedId] = useState(null);
  const [selected, setSelected] = useState(null);
  const [search, setSearch] = useState("");
  const [filter, setFilter] = useState("all");
  const [message, setMessage] = useState("");
  const [loading, setLoading] = useState(true);
  const [sending, setSending] = useState(false);
  const [agents, setAgents] = useState([]);
  const [quickReplies, setQuickReplies] = useState([]);
  const [copilot, setCopilot] = useState("");
  const [showProfile, setShowProfile] = useState(true);
  const [error, setError] = useState("");

  async function loadMeta() {
    try {
      const res = await fetch("/api/conversations/meta");
      const data = await res.json();

      setAgents(data.agents || []);
      setQuickReplies(data.quickReplies || []);
    } catch {
      setAgents([]);
      setQuickReplies([]);
    }
  }

  async function loadConversations() {
    try {
      setLoading(true);

      const params = new URLSearchParams();

      if (filter !== "all") {
        params.set("status", filter);
      }

      if (search.trim()) {
        params.set("search", search.trim());
      }

      const res = await fetch(
        `/api/conversations?${params.toString()}`,
        { cache: "no-store" }
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || "Failed to load conversations");
      }

      setConversations(data.conversations || []);
      setError("");

      if (!selectedId && data.conversations?.length) {
        setSelectedId(data.conversations[0].id);
      }
    } catch (err) {
      setError(err.message || "Failed to load conversations");
    } finally {
      setLoading(false);
    }
  }

  async function loadConversation(id) {
    if (!id) return;

    try {
      const res = await fetch(
        `/api/conversations/${id}`,
        { cache: "no-store" }
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || "Conversation not found");
      }

      setSelected(data.conversation);
    } catch (err) {
      setError(err.message || "Failed to load conversation");
    }
  }

  useEffect(() => {
    loadMeta();
  }, []);

  useEffect(() => {
    loadConversations();
  }, [filter, search]);

  useEffect(() => {
    if (selectedId) {
      loadConversation(selectedId);
    }
  }, [selectedId]);

  async function updateConversation(payload) {
    if (!selectedId) return;

    const res = await fetch(
      `/api/conversations/${selectedId}`,
      {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
      }
    );

    const data = await res.json();

    if (!res.ok) {
      throw new Error(data.error || "Update failed");
    }

    setSelected(data.conversation);
    await loadConversations();
  }

  async function sendMessage(text = message) {
    if (!selectedId || !text.trim() || sending) return;

    try {
      setSending(true);

      const res = await fetch(
        `/api/conversations/${selectedId}/messages`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            sender: selected?.assignedTo === "AI" ? "ai" : "agent",
            text: text.trim(),
            type: "text",
          }),
        }
      );

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || "Message failed");
      }

      setMessage("");
      setSelected(data.conversation);
      await loadConversations();
    } catch (err) {
      setError(err.message || "Could not send message");
    } finally {
      setSending(false);
    }
  }

  function useQuickReply(text) {
    setMessage(text);
  }

  function generateCopilot() {
    if (!selected) return;

    const lastCustomerMessage =
      [...(selected.messages || [])]
        .reverse()
        .find((m) => m.sender === "customer");

    if (!lastCustomerMessage) {
      setCopilot("مرحباً! كيف فينا نساعدك اليوم؟");
      return;
    }

    setCopilot(
      "شكراً لتواصلك معنا. فهمت طلبك، وسأساعدك بالتأكد من التفاصيل ومتابعة الموضوع معك."
    );
  }

  function channelLabel(channel) {
    if (channel === "whatsapp") return "◉ WhatsApp";
    if (channel === "instagram") return "◎ Instagram";
    return "◌ Web Chat";
  }

  function statusLabel(status) {
    if (status === "closed") return "Resolved";
    if (status === "human") return "Human";
    if (status === "pending") return "Pending";
    if (status === "new") return "New";
    return "Open";
  }

  function statusClass(status) {
    if (status === "closed") return "status closed";
    if (status === "human") return "status human";
    if (status === "pending") return "status pending";
    return "status open";
  }

  function formatTime(value) {
    if (!value) return "";

    try {
      return new Date(value).toLocaleTimeString([], {
        hour: "2-digit",
        minute: "2-digit",
      });
    } catch {
      return "";
    }
  }

  return (
    <div className="conversation-workspace">

      <div className="conversation-topbar">
        <div>
          <h2>Conversations</h2>
          <p>Manage customer conversations, agents and AI assistance.</p>
        </div>

        <div className="conversation-top-actions">
          <button
            className="secondary"
            type="button"
            onClick={() => setShowProfile((v) => !v)}
          >
            {showProfile ? "Hide profile" : "Show profile"}
          </button>
        </div>
      </div>

      <div className="conversation-layout">

        <aside className="conversation-list-panel">

          <div className="conversation-search">
            <input
              value={search}
              onChange={(e) => setSearch(e.target.value)}
              placeholder="Search conversations..."
            />
          </div>

          <div className="conversation-filters">
            {[
              ["all", "All"],
              ["new", "New"],
              ["open", "Open"],
              ["pending", "Pending"],
              ["human", "Human"],
              ["closed", "Resolved"],
            ].map(([value, label]) => (
              <button
                key={value}
                type="button"
                className={filter === value ? "filter active" : "filter"}
                onClick={() => setFilter(value)}
              >
                {label}
              </button>
            ))}
          </div>

          <div className="conversation-list">

            {loading && (
              <div className="empty-state">
                Loading conversations...
              </div>
            )}

            {!loading && !conversations.length && (
              <div className="empty-state">
                No conversations found.
              </div>
            )}

            {conversations.map((conversation) => {
              const customer = conversation.customer || {};
              const active = selectedId === conversation.id;

              return (
      <section className="dashboard-ai-agent-top">
        <div className="dashboard-ai-agent-header">
          <div className="dashboard-ai-agent-title">
            <div className="dashboard-ai-agent-icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 3.5a6.5 6.5 0 0 0-6.5 6.5v2.5a3 3 0 0 0 3 3h1v-6H7.5A4.5 4.5 0 0 1 12 5a4.5 4.5 0 0 1 4.5 4.5H16.5v6h1a3 3 0 0 0 3-3V10A6.5 6.5 0 0 0 12 3.5Z" stroke="currentColor" strokeWidth="1.7"/>
                <path d="M9.5 19.5h3a3 3 0 0 0 3-3v-1.5M9 16.5v1a2 2 0 0 0 2 2" stroke="currentColor" strokeWidth="1.7" strokeLinecap="round"/>
              </svg>
            </div>
            <div>
              <h2>WASSAL AI Agent</h2>
              <p>Chat, send messages and use voice from your dashboard</p>
            </div>
          </div>

          <div className="dashboard-ai-agent-status">
            <span></span>
            Online
          </div>
        </div>

        <div className="dashboard-ai-agent-message-row">
          <input
            className="dashboard-ai-agent-input"
            type="text"
            placeholder="Message WASSAL AI..."
            onKeyDown={(e) => {
              if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                setActive("AI Agent");
              }
            }}
          />

          <button
            type="button"
            className="dashboard-ai-agent-voice"
            onClick={() => setActive("AI Agent")}
            aria-label="Voice"
            title="Voice"
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="8" y="3" width="8" height="12" rx="4"
                stroke="currentColor" strokeWidth="1.8"/>
              <path d="M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6"
                stroke="currentColor" strokeWidth="1.8"
                strokeLinecap="round"/>
            </svg>
          </button>

          <button
            type="button"
            className="dashboard-ai-agent-send"
            onClick={() => setActive("AI Agent")}
          >
            <span>Send</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6"
                stroke="currentColor"
                strokeWidth="1.8"
                strokeLinecap="round"
                strokeLinejoin="round"/>
            </svg>
          </button>
        </div>
      </section>
                <button
                  key={conversation.id}
                  type="button"
                  className={
                    active
                      ? "conversation-item active"
                      : "conversation-item"
                  }
                  onClick={() => setSelectedId(conversation.id)}
                >
                  <div className="conversation-avatar">
                    {(customer.name || "?").charAt(0).toUpperCase()}
                  </div>

                  <div className="conversation-item-body">
                    <div className="conversation-item-head">
                      <strong>{customer.name || "Unknown"}</strong>
                      <span>{formatTime(conversation.updatedAt)}</span>
                    </div>

                    <div className="conversation-item-preview">
                      {conversation.lastMessage?.text ||
                        "No messages yet"}
                    </div>

                    <div className="conversation-item-meta">
                      <span>{channelLabel(conversation.channel)}</span>

                      <span className={statusClass(conversation.status)}>
                        {statusLabel(conversation.status)}
                      </span>
                    </div>
                  </div>
                </button>
              );
            })}

          </div>
        </aside>

        <main className="conversation-main">

          {!selected ? (
            <div className="conversation-empty">
              <div className="empty-icon">◌</div>
              <h3>Select a conversation</h3>
              <p>Choose a customer conversation to start.</p>
            </div>
          ) : (
            <>
              <div className="conversation-header">

                <div className="conversation-customer-title">
                  <div className="large-avatar">
                    {(selected.customer?.name || "?")
                      .charAt(0)
                      .toUpperCase()}
                  </div>

                  <div>
                    <h3>
                      {selected.customer?.name || "Unknown customer"}
                    </h3>

                    <div className="conversation-channel">
                      {channelLabel(selected.channel)}
                    </div>
                  </div>
                </div>

                <div className="conversation-actions">

                  <select
                    value={selected.assignedTo || "AI"}
                    onChange={async (e) => {
                      try {
                        await updateConversation({
                          assignedTo: e.target.value,
                          status:
                            e.target.value === "AI"
                              ? "open"
                              : "human",
                        });
                      } catch (err) {
                        setError(err.message);
                      }
                    }}
                  >
                    {agents.map((agent) => (
                      <option key={agent.id} value={agent.id}>
                        {agent.type === "ai" ? "🤖 " : "👤 "}
                        {agent.name}
                      </option>
                    ))}
                  </select>

                  {selected.status !== "closed" && (
                    <button
                      className="secondary"
                      type="button"
                      onClick={() =>
                        updateConversation({
                          status: "closed",
                        })
                      }
                    >
                      ✓ Resolve
                    </button>
                  )}

                  {selected.status === "closed" && (
                    <button
                      className="secondary"
                      type="button"
                      onClick={() =>
                        updateConversation({
                          status: "open",
                        })
                      }
                    >
                      Reopen
                    </button>
                  )}

                  <button
                    className="primary"
                    type="button"
                    onClick={() =>
                      updateConversation({
                        assignedTo:
                          selected.assignedTo === "AI"
                            ? "agent-001"
                            : "AI",
                        status:
                          selected.assignedTo === "AI"
                            ? "human"
                            : "open",
                      })
                    }
                  >
                    {selected.assignedTo === "AI"
                      ? "Pass to Human"
                      : "Return to AI"}
                  </button>

                </div>
              </div>

              <div className="message-area">

                {(selected.messages || []).map((msg) => (
                  <div
                    key={msg.id}
                    className={
                      msg.sender === "customer"
                        ? "message customer"
                        : "message agent"
                    }
                  >
                    <div className="message-bubble">
                      <div>{msg.text}</div>

                      <small>
                        {msg.sender === "customer"
                          ? "Customer"
                          : msg.sender === "ai"
                          ? "WASSAL AI"
                          : "Agent"}{" "}
                        · {formatTime(msg.createdAt)}
                      </small>
                    </div>
                  </div>
                ))}

              </div>

              <div className="composer-area">

                <div className="quick-replies">
                  <div className="quick-title">
                    Quick Replies
                  </div>

                  <div className="quick-buttons">
                    {quickReplies.map((reply) => (
                      <button
                        key={reply.id}
                        type="button"
                        onClick={() => useQuickReply(reply.text)}
                      >
                        {reply.title}
                      </button>
                    ))}
                  </div>
                </div>

                <div className="copilot-box">
                  <div>
                    <strong>🤖 AI Copilot</strong>
                    <span>
                      Suggested response for your agent
                    </span>
                  </div>

                  <button
                    type="button"
                    onClick={generateCopilot}
                  >
                    Suggest
                  </button>

                  {copilot && (
                    <button
                      type="button"
                      className="copilot-suggestion"
                      onClick={() => {
                        setMessage(copilot);
                        setCopilot("");
                      }}
                    >
                      {copilot}
                    </button>
                  )}
                </div>

                <div className="composer">

                  <textarea
                    value={message}
                    onChange={(e) => setMessage(e.target.value)}
                    placeholder="Write a reply..."
                    rows={3}
                    onKeyDown={(e) => {
                      if (
                        e.key === "Enter" &&
                        !e.shiftKey
                      ) {
                        e.preventDefault();
                        sendMessage();
                      }
                    }}
                  />

                  <button
                    className="primary send-button"
                    type="button"
                    disabled={
                      sending || !message.trim()
                    }
                    onClick={() => sendMessage()}
                  >
                    {sending ? "Sending..." : "Send"}
                  </button>

                </div>

              </div>
            </>
          )}
        </main>

        {showProfile && (
          <aside className="customer-panel">

            {selected ? (
              <>
                <div className="profile-header">
                  <div className="profile-avatar">
                    {(selected.customer?.name || "?")
                      .charAt(0)
                      .toUpperCase()}
                  </div>

                  <h3>
                    {selected.customer?.name ||
                      "Unknown customer"}
                  </h3>

                  <span>
                    {channelLabel(selected.channel)}
                  </span>
                </div>

                <div className="profile-section">
                  <label>Phone</label>
                  <div>
                    {selected.customer?.phone || "—"}
                  </div>
                </div>

                <div className="profile-section">
                  <label>Email</label>
                  <div>
                    {selected.customer?.email || "—"}
                  </div>
                </div>

                <div className="profile-section">
                  <label>Assigned Agent</label>

                  <select
                    value={selected.assignedTo || "AI"}
                    onChange={(e) =>
                      updateConversation({
                        assignedTo: e.target.value,
                        status:
                          e.target.value === "AI"
                            ? "open"
                            : "human",
                      })
                    }
                  >
                    {agents.map((agent) => (
                      <option
                        key={agent.id}
                        value={agent.id}
                      >
                        {agent.name}
                      </option>
                    ))}
                  </select>
                </div>

                <div className="profile-section">
                  <label>Tags</label>

                  <div className="tags">
                    {(selected.customer?.tags || []).map(
                      (tag) => (
                        <span key={tag}>{tag}</span>
                      )
                    )}

                    {!selected.customer?.tags?.length && (
                      <span>Lead</span>
                    )}
                  </div>
                </div>

                <div className="profile-section">
                  <label>Notes</label>

                  <textarea
                    defaultValue={
                      selected.customer?.notes || ""
                    }
                    placeholder="Customer notes..."
                    onBlur={(e) =>
                      updateConversation({
                        customer: {
                          notes: e.target.value,
                        },
                      })
                    }
                  />
                </div>

                <div className="profile-section">
                  <label>Status</label>

                  <div className={statusClass(selected.status)}>
                    {statusLabel(selected.status)}
                  </div>
                </div>
              </>
            ) : (
              <div className="empty-state">
                Customer profile
              </div>
            )}

          </aside>
        )}

      </div>

      {error && (
        <div className="conversation-error">
          {error}
        </div>
      )}

      <style jsx>{`
        .conversation-workspace {
          width: 100%;
        }

        .conversation-topbar {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 16px;
          margin-bottom: 18px;
        }

        .conversation-topbar h2 {
          margin: 0;
          font-size: 28px;
        }

        .conversation-topbar p {
          margin: 6px 0 0;
          opacity: .65;
        }

        .conversation-layout {
          display: grid;
          grid-template-columns: 300px minmax(0, 1fr) 280px;
          min-height: 680px;
          border: 1px solid rgba(255,255,255,.09);
          border-radius: 18px;
          overflow: hidden;
          background: rgba(255,255,255,.025);
        }

        .conversation-list-panel,
        .customer-panel {
          background: rgba(255,255,255,.025);
        }

        .conversation-list-panel {
          border-right: 1px solid rgba(255,255,255,.08);
        }

        .customer-panel {
          border-left: 1px solid rgba(255,255,255,.08);
          padding: 20px;
        }

        .conversation-search {
          padding: 14px;
        }

        .conversation-search input,
        .composer textarea,
        .profile-section textarea,
        .profile-section select,
        .conversation-actions select {
          width: 100%;
          border: 1px solid rgba(255,255,255,.12);
          background: rgba(0,0,0,.18);
          color: inherit;
          border-radius: 10px;
          padding: 10px 12px;
          outline: none;
        }

        .conversation-filters {
          display: flex;
          gap: 6px;
          overflow-x: auto;
          padding: 0 12px 12px;
        }

        .filter,
        .quick-buttons button {
          border: 1px solid rgba(255,255,255,.1);
          background: transparent;
          color: inherit;
          border-radius: 999px;
          padding: 7px 10px;
          cursor: pointer;
          white-space: nowrap;
        }

        .filter.active {
          background: rgba(255,255,255,.12);
        }

        .conversation-item {
          width: 100%;
          display: flex;
          gap: 10px;
          padding: 14px;
          border: 0;
          border-top: 1px solid rgba(255,255,255,.06);
          background: transparent;
          color: inherit;
          text-align: left;
          cursor: pointer;
        }

        .conversation-item:hover,
        .conversation-item.active {
          background: rgba(255,255,255,.07);
        }

        .conversation-avatar,
        .large-avatar,
        .profile-avatar {
          flex: 0 0 auto;
          display: grid;
          place-items: center;
          border-radius: 50%;
          font-weight: 800;
          background: rgba(255,255,255,.12);
        }

        .conversation-avatar {
          width: 38px;
          height: 38px;
        }

        .conversation-item-body {
          min-width: 0;
          flex: 1;
        }

        .conversation-item-head {
          display: flex;
          justify-content: space-between;
          gap: 8px;
        }

        .conversation-item-head span,
        .conversation-item-preview,
        .conversation-channel {
          opacity: .6;
          font-size: 12px;
        }

        .conversation-item-preview {
          margin: 5px 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .conversation-item-meta {
          display: flex;
          justify-content: space-between;
          gap: 5px;
          font-size: 11px;
        }

        .conversation-main {
          display: flex;
          flex-direction: column;
          min-width: 0;
        }

        .conversation-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 15px;
          padding: 16px 18px;
          border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .conversation-customer-title {
          display: flex;
          align-items: center;
          gap: 10px;
        }

        .conversation-customer-title h3 {
          margin: 0 0 4px;
        }

        .large-avatar {
          width: 44px;
          height: 44px;
        }

        .conversation-actions {
          display: flex;
          gap: 8px;
          align-items: center;
        }

        .conversation-actions button,
        .conversation-actions select {
          width: auto;
        }

        .primary,
        .secondary {
          border-radius: 9px;
          padding: 9px 13px;
          cursor: pointer;
        }

        .primary {
          border: 0;
          background: #fff;
          color: #111;
          font-weight: 700;
        }

        .secondary {
          border: 1px solid rgba(255,255,255,.13);
          background: transparent;
          color: inherit;
        }

        .message-area {
          flex: 1;
          overflow-y: auto;
          padding: 22px;
        }

        .message {
          display: flex;
          margin-bottom: 12px;
        }

        .message.customer {
          justify-content: flex-start;
        }

        .message.agent {
          justify-content: flex-end;
        }

        .message-bubble {
          max-width: 72%;
          padding: 11px 14px;
          border-radius: 14px;
          background: rgba(255,255,255,.08);
        }

        .message.agent .message-bubble {
          background: rgba(255,255,255,.14);
        }

        .message-bubble small {
          display: block;
          margin-top: 5px;
          opacity: .5;
          font-size: 10px;
        }

        .composer-area {
          border-top: 1px solid rgba(255,255,255,.08);
          padding: 14px;
        }

        .quick-title,
        .profile-section label {
          display: block;
          font-size: 11px;
          opacity: .55;
          margin-bottom: 7px;
        }

        .quick-buttons {
          display: flex;
          gap: 6px;
          overflow-x: auto;
          margin-bottom: 12px;
        }

        .copilot-box {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
          align-items: center;
          padding: 10px;
          margin-bottom: 10px;
          border: 1px solid rgba(255,255,255,.1);
          border-radius: 12px;
        }

        .copilot-box > div:first-child {
          display: flex;
          flex-direction: column;
          flex: 1;
          min-width: 150px;
        }

        .copilot-box span {
          opacity: .55;
          font-size: 11px;
        }

        .copilot-box button {
          border: 0;
          border-radius: 8px;
          padding: 7px 10px;
          cursor: pointer;
        }

        .copilot-suggestion {
          width: 100%;
          text-align: left;
          background: rgba(255,255,255,.07);
          color: inherit;
        }

        .composer {
          display: flex;
          gap: 8px;
          align-items: flex-end;
        }

        .composer textarea {
          resize: vertical;
          flex: 1;
        }

        .send-button {
          min-width: 75px;
        }

        .profile-header {
          text-align: center;
          padding-bottom: 20px;
          border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .profile-avatar {
          width: 62px;
          height: 62px;
          margin: 0 auto 10px;
          font-size: 22px;
        }

        .profile-header h3 {
          margin: 0 0 5px;
        }

        .profile-header span {
          opacity: .55;
          font-size: 12px;
        }

        .profile-section {
          padding: 15px 0;
          border-bottom: 1px solid rgba(255,255,255,.06);
        }

        .profile-section textarea {
          min-height: 75px;
          resize: vertical;
        }

        .tags {
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
        }

        .tags span {
          padding: 5px 8px;
          border-radius: 999px;
          background: rgba(255,255,255,.1);
          font-size: 11px;
        }

        .status {
          display: inline-block;
          padding: 5px 8px;
          border-radius: 999px;
          font-size: 11px;
        }

        .status.open {
          background: rgba(50,180,100,.15);
        }

        .status.pending {
          background: rgba(220,170,50,.15);
        }

        .status.human {
          background: rgba(80,140,220,.15);
        }

        .status.closed {
          background: rgba(150,150,150,.15);
        }

        .conversation-empty,
        .empty-state {
          display: grid;
          place-items: center;
          text-align: center;
          min-height: 200px;
          opacity: .65;
          padding: 20px;
        }

        .empty-icon {
          font-size: 40px;
        }

        .conversation-error {
          margin-top: 10px;
          padding: 10px 12px;
          border-radius: 10px;
          background: rgba(220,70,70,.12);
        }

        @media (max-width: 1100px) {
          .conversation-layout {
            grid-template-columns: 280px minmax(0,1fr);
          }

          .customer-panel {
            display: none;
          }
        }

        @media (max-width: 760px) {
          .conversation-layout {
            grid-template-columns: 1fr;
          }

          .conversation-list-panel {
            display: none;
          }

          .conversation-header {
            flex-direction: column;
            align-items: stretch;
          }

          .conversation-actions {
            flex-wrap: wrap;
          }

          .conversation-actions button,
          .conversation-actions select {
            flex: 1;
          }
        }
      `}</style>
    </div>
  );
}

function ContactsPage() {
  const defaultContacts = [
    { id: 1, name: "Ahmad Hassan", phone: "+96170123456", email: "ahmad@example.com", company: "Hassan Trading", conversations: 12, lastContact: "1 min ago", channel: "WhatsApp", status: "Active" },
    { id: 2, name: "Sara Khalil", phone: "+96171234567", email: "sara@example.com", company: "Khalil Design", conversations: 8, lastContact: "3 min ago", channel: "WhatsApp", status: "Active" },
    { id: 3, name: "Omar Nasser", phone: "+96176345678", email: "omar@example.com", company: "Nasser Group", conversations: 6, lastContact: "7 min ago", channel: "Voice", status: "Active" },
    { id: 4, name: "Lina Haddad", phone: "+96178456789", email: "lina@example.com", company: "Haddad Store", conversations: 15, lastContact: "18 min ago", channel: "WhatsApp", status: "Active" },
    { id: 5, name: "Karim Saleh", phone: "+96179567890", email: "karim@example.com", company: "Saleh Services", conversations: 4, lastContact: "32 min ago", channel: "Voice", status: "Active" },
  ];

  const [contacts, setContacts] = useState(() => {
    if (typeof window === "undefined") return defaultContacts;
    try {
      const saved = localStorage.getItem("wassal_contacts");
      const parsed = saved ? JSON.parse(saved) : null;
      return Array.isArray(parsed) ? parsed : defaultContacts;
    } catch {
      return defaultContacts;
    }
  });

  const [selectedId, setSelectedId] = useState(1);
  const [search, setSearch] = useState("");
  const [showAdd, setShowAdd] = useState(false);
  const [form, setForm] = useState({
    name: "",
    phone: "",
    email: "",
    company: "",
  });

  useEffect(() => {
    if (typeof window !== "undefined") {
      try {
        localStorage.setItem("wassal_contacts", JSON.stringify(contacts));
      } catch (error) {
        console.warn("Could not save contacts:", error);
      }
    }
  }, [contacts]);

  const filtered = contacts.filter((c) => {
    const q = search.toLowerCase().trim();
    if (!q) return true;
    return (
      String(c.name || "").toLowerCase().includes(q) ||
      String(c.phone || "").toLowerCase().includes(q) ||
      String(c.email || "").toLowerCase().includes(q) ||
      String(c.company || "").toLowerCase().includes(q)
    );
  });

  const selected =
    contacts.find((c) => c.id === selectedId) ||
    filtered[0] ||
    contacts[0] ||
    defaultContacts[0];


  async function importPhoneContacts() {
    try {
      if (!navigator.contacts || !navigator.contacts.select) {
        alert("Phone contact access is not supported here. Try Chrome on Android.");
        return;
      }

      const picked = await navigator.contacts.select(
        ["name", "tel", "email"],
        { multiple: true }
      );

      if (!picked || !picked.length) return;

      const imported = picked
        .map((item, index) => {
          const name = Array.isArray(item.name) ? item.name[0] : item.name;
          const phone = Array.isArray(item.tel) ? item.tel[0] : item.tel;
          const email = Array.isArray(item.email) ? item.email[0] : item.email;

          if (!phone) return null;

          return {
            id: Date.now() + index,
            name: name || "Phone contact",
            phone,
            email: email || "—",
            company: "Phone contact",
            conversations: 0,
            lastContact: "Just now",
            channel: "WhatsApp",
            status: "Active",
          };
        })
        .filter(Boolean);

      if (!imported.length) {
        alert("No phone numbers were found.");
        return;
      }

      setContacts((old) => {
        const existing = new Set(
          old.map((c) => String(c.phone || "").replace(/\D/g, ""))
        );

        const fresh = imported.filter((c) => {
          const number = String(c.phone || "").replace(/\D/g, "");
          return number && !existing.has(number);
        });

        return [...fresh, ...old];
      });

      setSelectedId(imported[0].id);
    } catch (error) {
      if (error?.name !== "AbortError") {
        console.error(error);
        alert("Could not access phone contacts.");
      }
    }
  }

  function newConversation(phone) {
    const number = String(phone || "").replace(/\D/g, "");

    if (!number) {
      alert("Invalid phone number.");
      return;
    }

    window.location.href = "https://wa.me/" + number;
  }

  function saveContact() {
    const name = form.name.trim();
    const phone = form.phone.trim();

    if (!name || !phone) {
      alert("Please enter a name and phone number.");
      return;
    }

    const contact = {
      id: Date.now(),
      name,
      phone,
      email: form.email.trim() || "—",
      company: form.company.trim() || "—",
      conversations: 0,
      lastContact: "Just now",
      channel: "WhatsApp",
      status: "Active",
    };

    setContacts((old) => [contact, ...old]);
    setSelectedId(contact.id);
    setForm({ name: "", phone: "", email: "", company: "" });
    setShowAdd(false);
  }

  function openWhatsApp(phone) {
    const number = String(phone || "").replace(/\D/g, "");
    if (!number) return alert("Invalid phone number.");
    window.open("https://wa.me/" + number, "_blank");
  }

  function startCall(phone) {
    const number = String(phone || "").replace(/[^\d+]/g, "");
    if (!number) return alert("Invalid phone number.");
    window.location.href = "tel:" + number;
  }

  if (!selected) {
    return (
      <div className="page contacts-page">
        <div className="contacts-toolbar">
          <div>
            <div className="eyebrow">CUSTOMER DIRECTORY</div>
            <h2>Contacts</h2>
            <p>Manage your customers and communication details.</p>
          </div>
          <button className="primary" onClick={() => setShowAdd(true)}>
            + Add contact
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="page contacts-page">
      <div className="contacts-toolbar">
        <div>
          <div className="eyebrow">CUSTOMER DIRECTORY</div>
          <h2>Contacts</h2>
          <p>Manage your customers and communication details.</p>
        </div>

        <div className="contacts-toolbar-buttons">
          <button className="primary" onClick={importPhoneContacts}>
            📱 Choose phone contacts
          </button>

          <button className="secondary" onClick={() => setShowAdd(true)}>
            + Add contact
          </button>
        </div>
      </div>

      {showAdd && (
        <div className="card add-contact-panel">
          <strong>Add a new contact</strong>

          <div className="add-contact-grid">
            <input
              value={form.name}
              onChange={(e) => setForm({ ...form, name: e.target.value })}
              placeholder="Name *"
            />
            <input
              value={form.phone}
              onChange={(e) => setForm({ ...form, phone: e.target.value })}
              placeholder="Phone *"
              type="tel"
            />
            <input
              value={form.email}
              onChange={(e) => setForm({ ...form, email: e.target.value })}
              placeholder="Email"
              type="email"
            />
            <input
              value={form.company}
              onChange={(e) => setForm({ ...form, company: e.target.value })}
              placeholder="Company"
            />
          </div>

          <div className="add-contact-buttons">
            <button className="primary" onClick={saveContact}>
              Save contact
            </button>
            <button className="secondary" onClick={() => setShowAdd(false)}>
              Cancel
            </button>
          </div>
        </div>
      )}

      <div className="contacts-layout">
        <section className="card contacts-list">
          <div className="contacts-list-head">
            <div className="conversation-search">
              <span>⌕</span>
              <input
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Search contacts..."
              />
            </div>
            <div className="contacts-count">{filtered.length} contacts</div>
          </div>

          <div className="contact-items">
            {filtered.map((contact) => (
              <button
                key={contact.id}
                className={
                  selectedId === contact.id
                    ? "contact-item selected"
                    : "contact-item"
                }
                onClick={() => setSelectedId(contact.id)}
              >
                <div className="contact-avatar">
                  {(contact.name || "?").charAt(0).toUpperCase()}
                </div>
                <div className="contact-main">
                  <div className="contact-name-row">
                    <strong>{contact.name}</strong>
                    <span>{contact.lastContact}</span>
                  </div>
                  <p>{contact.phone}</p>
                  <div className="contact-meta">
                    <span className="channel-tag">
                      ◉ {contact.channel}
                    </span>
                    <span className="conversation-number">
                      {contact.conversations} conversations
                    </span>
                  </div>
                </div>
              </button>
            ))}

            {!filtered.length && (
              <div className="empty-conversations">
                <strong>No contacts found</strong>
                <p>Try another name or phone number.</p>
              </div>
            )}
          </div>
        </section>

        <section className="card contact-detail">
          <div className="contact-detail-head">
            <div className="large-contact-avatar">
              {(selected.name || "?").charAt(0).toUpperCase()}
            </div>

            <div className="contact-title">
              <strong>{selected.name}</strong>
              <span>● {selected.status}</span>
            </div>
          </div>

          <div className="contact-information">
            <div className="section-title">CONTACT INFORMATION</div>

            <div className="info-row">
              <span className="info-icon">☎</span>
              <div>
                <small>Phone</small>
                <strong>{selected.phone}</strong>
              </div>
            </div>

            <div className="info-row">
              <span className="info-icon">✉</span>
              <div>
                <small>Email</small>
                <strong>{selected.email}</strong>
              </div>
            </div>

            <div className="info-row">
              <span className="info-icon">▣</span>
              <div>
                <small>Company</small>
                <strong>{selected.company}</strong>
              </div>
            </div>
          </div>

          <div className="contact-actions">
            <button
              className="primary contact-action"
              onClick={() => newConversation(selected.phone)}
            >
              💬 New Conversation
            </button>

            <button
              className="secondary contact-action"
              onClick={() => openWhatsApp(selected.phone)}
            >
              ◉ Open WhatsApp
            </button>

            <button
              className="secondary contact-action"
              onClick={() => startCall(selected.phone)}
            >
              📞 Start Call
            </button>
          </div>
        </section>
      </div>

      <style jsx>{`
        .contacts-page { padding-top: 28px; }
        .contacts-toolbar {
          display:flex;
          align-items:flex-end;
          justify-content:space-between;
          gap:16px;
          margin-bottom:22px;
        }
        .contacts-toolbar-buttons {
          display:flex;
          gap:10px;
          flex-wrap:wrap;
        }
        .add-contact-panel {
          padding:20px;
          margin-bottom:18px;
        }
        .add-contact-grid {
          display:grid;
          grid-template-columns:repeat(2,1fr);
          gap:10px;
          margin-top:16px;
        }
        .add-contact-grid input {
          box-sizing:border-box;
          width:100%;
          padding:13px;
          border-radius:10px;
          border:1px solid rgba(255,255,255,.1);
          background:rgba(255,255,255,.04);
          color:inherit;
          outline:none;
        }
        .add-contact-buttons {
          display:flex;
          gap:10px;
          margin-top:14px;
        }
        .contacts-layout {
          display:grid;
          grid-template-columns:minmax(300px,.9fr) minmax(360px,1.1fr);
          gap:18px;
        }
        .contacts-list { overflow:hidden; }
        .contacts-list-head {
          display:flex;
          align-items:center;
          gap:12px;
          padding:15px;
          border-bottom:1px solid rgba(255,255,255,.07);
        }
        .conversation-search {
          display:flex;
          gap:8px;
          align-items:center;
          flex:1;
          padding:10px;
          border-radius:10px;
          background:rgba(255,255,255,.035);
        }
        .conversation-search input {
          width:100%;
          border:0;
          outline:0;
          background:transparent;
          color:inherit;
        }
        .contacts-count {
          font-size:12px;
          opacity:.55;
        }
        .contact-item {
          width:100%;
          display:flex;
          gap:12px;
          padding:14px 15px;
          border:0;
          border-bottom:1px solid rgba(255,255,255,.05);
          background:transparent;
          color:inherit;
          text-align:left;
          cursor:pointer;
        }
        .contact-item:hover,
        .contact-item.selected {
          background:rgba(255,255,255,.045);
        }
        .contact-avatar,
        .large-contact-avatar {
          display:flex;
          align-items:center;
          justify-content:center;
          border-radius:50%;
          background:rgba(255,255,255,.09);
          font-weight:700;
          flex-shrink:0;
        }
        .contact-avatar { width:42px;height:42px; }
        .large-contact-avatar { width:54px;height:54px;font-size:18px; }
        .contact-main { flex:1;min-width:0; }
        .contact-name-row {
          display:flex;
          justify-content:space-between;
          gap:8px;
        }
        .contact-name-row span {
          font-size:11px;
          opacity:.45;
        }
        .contact-main p {
          margin:5px 0 8px;
          opacity:.6;
          font-size:13px;
        }
        .contact-meta {
          display:flex;
          gap:10px;
          font-size:11px;
          opacity:.65;
        }
        .contact-detail { padding:22px; }
        .contact-detail-head {
          display:flex;
          align-items:center;
          gap:13px;
        }
        .contact-title {
          display:flex;
          flex-direction:column;
          gap:5px;
        }
        .contact-title span {
          font-size:12px;
          opacity:.55;
        }
        .contact-information { margin-top:28px; }
        .section-title {
          font-size:10px;
          letter-spacing:.12em;
          opacity:.5;
          margin-bottom:14px;
        }
        .info-row {
          display:flex;
          align-items:center;
          gap:12px;
          padding:13px 0;
          border-bottom:1px solid rgba(255,255,255,.055);
        }
        .info-icon {
          width:34px;
          height:34px;
          display:flex;
          align-items:center;
          justify-content:center;
          border-radius:10px;
          background:rgba(255,255,255,.05);
        }
        .info-row small,
        .info-row strong { display:block; }
        .info-row small {
          font-size:10px;
          opacity:.48;
          margin-bottom:3px;
        }
        .info-row strong { font-size:13px; }
        .contact-actions {
          display:grid;
          grid-template-columns:repeat(3,1fr);
          gap:10px;
          margin-top:24px;
        }
        .contact-action { min-height:44px; }
        @media(max-width:900px) {
          .contacts-layout { grid-template-columns:1fr; }
        }
        @media(max-width:600px) {
          .contacts-toolbar {
            flex-direction:column;
            align-items:stretch;
          }
          .add-contact-grid { grid-template-columns:1fr; }
          .contact-actions { grid-template-columns:1fr; }
        }
      `}</style>
    </div>
  );
}




function VoicePage() {
  const [listening, setListening] = useState(false);
  const [text, setText] = useState("");
  const [reply, setReply] = useState("");
  const [loading, setLoading] = useState(false);

  function startVoice() {
    const SpeechRecognition =
      window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
      alert("Voice recognition is not supported on this browser.");
      return;
    }

    const recognition = new SpeechRecognition();
    recognition.lang = "ar-LB";
    recognition.interimResults = false;
    recognition.continuous = false;

    recognition.onstart = () => setListening(true);
    recognition.onend = () => setListening(false);

    recognition.onerror = () => {
      setListening(false);
      alert("Could not access the microphone.");
    };

    recognition.onresult = async (event) => {
      const spoken = event.results[0][0].transcript;
      setText(spoken);
      setLoading(true);

      try {
        const response = await fetch("/api/agent", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            message: spoken,
          }),
        });

        const data = await response.json();
        const answer =
          data.reply ||
          data.message ||
          data.output ||
          "ما قدرت آخد جواب من الـAI.";

        setReply(answer);

        if ("speechSynthesis" in window) {
          window.speechSynthesis.cancel();

          const utterance = new SpeechSynthesisUtterance(answer);
          utterance.lang = /[\u0600-\u06FF]/.test(answer)
            ? "ar-LB"
            : "en-US";

          window.speechSynthesis.speak(utterance);
        }
      } catch (error) {
        setReply("صار خطأ أثناء الاتصال بالـAI.");
      } finally {
        setLoading(false);
      }
    };

    recognition.start();
  }

  return (
    <div className="page">
      <section className="card settings-card">

        <div className="card-head">
          <div>
            <h3>🎙️ Voice</h3>
            <p>Talk to WASSAL AI using your voice.</p>
          </div>
        </div>

        <div className="voice-center">

          <button
            type="button"
            className={listening ? "voice-button listening" : "voice-button"}
            onClick={startVoice}
            disabled={listening}
          >
            {listening ? "🎙️ Listening..." : "🎤 Start Voice"}
          </button>

          <div className="voice-status">
            {listening
              ? "WASSAL AI is listening..."
              : "Press the microphone and start speaking."}
          </div>

          {text && (
            <div className="voice-box">
              <small>You said</small>
              <p>{text}</p>
            </div>
          )}

          {loading && (
            <div className="voice-box">
              <p>🤖 WASSAL AI is thinking...</p>
            </div>
          )}

          {reply && (
            <div className="voice-box">
              <small>WASSAL AI</small>
              <p>{reply}</p>

              <button
                type="button"
                className="secondary"
                onClick={() => {
                  if ("speechSynthesis" in window) {
                    window.speechSynthesis.cancel();
                    const utterance = new SpeechSynthesisUtterance(reply);
                    utterance.lang = /[\u0600-\u06FF]/.test(reply)
                      ? "ar-LB"
                      : "en-US";
                    window.speechSynthesis.speak(utterance);
                  }
                }}
              >
                🔊 Play Response
              </button>
            </div>
          )}

        </div>
      </section>
    </div>
  );
}



function CallChatPage() {
  const [chooseOpen, setChooseOpen] = useState(false);
  const [number, setNumber] = useState("");
  const [message, setMessage] = useState("");
  const [agentCommand, setAgentCommand] = useState("");
  const [agentReply, setAgentReply] = useState("");
  const [agentReady, setAgentReady] = useState(false);
  const [recording, setRecording] = useState(false);
  const [audioUrl, setAudioUrl] = useState("");
  const [busy, setBusy] = useState(false);

  const normalizeLebanon = (value) => {
    let n = String(value || "").replace(/[^\d+]/g, "");

    if (n.startsWith("+961")) {
      return n;
    }

    if (n.startsWith("00961")) {
      return "+" + n.slice(2);
    }

    if (/^0\d{7,8}$/.test(n)) {
      return "+961" + n.slice(1);
    }

    if (/^\d{7,8}$/.test(n)) {
      return "+961" + n;
    }

    return n;
  };

  const chooseContact = async () => {
    try {
      if (!navigator.contacts?.select) {
        alert("Contact Picker is not supported by this browser.");
        return;
      }

      const contacts = await navigator.contacts.select(
        ["name", "tel"],
        { multiple: false }
      );

      if (contacts?.length) {
        const contact = contacts[0];
        const rawNumber = Array.isArray(contact.tel)
          ? contact.tel[0]
          : contact.tel || "";

        setNumber(normalizeLebanon(rawNumber));
        setChooseOpen(false);
      }
    } catch (error) {
      console.error(error);
    }
  };

  const openWhatsApp = () => {
    const clean = normalizeLebanon(number);

    if (!clean) {
      alert("Choose or enter a WhatsApp number first.");
      return;
    }

    if (!message.trim()) {
      alert("Write a message first.");
      return;
    }

    const digits = clean.replace(/\D/g, "");
    const url =
      "https://wa.me/" +
      digits +
      "?text=" +
      encodeURIComponent(message.trim());

    window.open(url, "_blank");
  };

  const startRecording = async () => {
    try {
      if (!navigator.mediaDevices?.getUserMedia) {
        alert("Voice recording is not supported by this browser.");
        return;
      }

      const stream = await navigator.mediaDevices.getUserMedia({
        audio: true,
      });

      const chunks = [];
      const recorder = new MediaRecorder(stream);

      recorder.ondataavailable = (event) => {
        if (event.data.size > 0) {
          chunks.push(event.data);
        }
      };

      recorder.onstop = () => {
        const blob = new Blob(chunks, { type: "audio/webm" });
        setAudioUrl(URL.createObjectURL(blob));
        stream.getTracks().forEach((track) => track.stop());
      };

      recorder.start();
      setRecording(true);

      setTimeout(() => {
        if (recorder.state !== "inactive") {
          recorder.stop();
          setRecording(false);
        }
      }, 60000);

      window.__wassalRecorder = recorder;
    } catch (error) {
      console.error(error);
      alert("Microphone permission is required.");
    }
  };

  const stopRecording = () => {
    const recorder = window.__wassalRecorder;

    if (recorder && recorder.state !== "inactive") {
      recorder.stop();
    }

    setRecording(false);
  };

  const prepareAgent = async () => {
    if (!agentCommand.trim()) {
      alert("Write or speak a command for the AI Agent.");
      return;
    }

    setBusy(true);
    setAgentReady(false);
    setAgentReply("");

    try {
      // WASSAL CONTACT MEMORY
      // ContactsPage already stores contacts in localStorage.
      let savedContacts = [];

      try {
        const raw = localStorage.getItem("wassal_contacts");
        const parsed = raw ? JSON.parse(raw) : [];
        savedContacts = Array.isArray(parsed) ? parsed : [];
      } catch (error) {
        console.warn("Could not read WASSAL contacts:", error);
      }

      // Normalize Lebanese / international numbers
      const normalizeAgentNumber = (value) => {
        let n = String(value || "").replace(/[^\d+]/g, "");

        if (n.startsWith("+961")) return n;
        if (n.startsWith("00961")) return "+" + n.slice(2);

        if (/^0\d{7,8}$/.test(n)) {
          return "+961" + n.slice(1);
        }

        if (/^\d{7,8}$/.test(n)) {
          return "+961" + n;
        }

        return n;
      };

      const command = agentCommand.trim();

      /*
       * Examples understood directly by WASSAL:
       *
       * ابعت لأحمد: مرحبا كيفك
       * ابعت لاحمد مرحبا كيفك
       * اكتب لأحمد: وينك؟
       * أرسل إلى أحمد: مرحبا
       * send to Ahmad: hello
       */

      let contactName = "";
      let commandMessage = "";

      const arabicMatch = command.match(
        /(?:ابعت|أبعت|ارسل|أرسل|اكتب|ابعث|بعت)\s+(?:ل|لـ|الى|إلى)\s+([^:،,]+?)\s*(?::|،|,)\s*(.+)$/i
      );

      const arabicMatchNoColon = command.match(
        /(?:ابعت|أبعت|ارسل|أرسل|اكتب|ابعث|بعت)\s+(?:ل|لـ|الى|إلى)\s+(.+?)\s+(.+)$/i
      );

      const englishMatch = command.match(
        /(?:send|message|text)\s+(?:to)\s+([^:,-]+?)\s*(?::|,|-)\s*(.+)$/i
      );

      if (arabicMatch) {
        contactName = arabicMatch[1].trim();
        commandMessage = arabicMatch[2].trim();
      } else if (arabicMatchNoColon) {
        contactName = arabicMatchNoColon[1].trim();
        commandMessage = arabicMatchNoColon[2].trim();
      } else if (englishMatch) {
        contactName = englishMatch[1].trim();
        commandMessage = englishMatch[2].trim();
      }

      // If the command doesn't contain a message, keep the manually
      // entered WhatsApp message as a fallback.
      if (!commandMessage && message.trim()) {
        commandMessage = message.trim();
      }

      // Remove common Arabic articles / command noise from the name.
      contactName = contactName
        .replace(/^(ال|لل)/, "")
        .replace(/[؟?!.,،:]+$/, "")
        .trim();

      // Find contact by name.
      let matchedContact = null;

      if (contactName) {
        const wanted = contactName
          .toLowerCase()
          .replace(/[إأآا]/g, "ا")
          .replace(/ة/g, "ه")
          .replace(/\s+/g, " ")
          .trim();

        matchedContact = savedContacts.find((contact) => {
          const name = String(contact?.name || "")
            .toLowerCase()
            .replace(/[إأآا]/g, "ا")
            .replace(/ة/g, "ه")
            .replace(/\s+/g, " ")
            .trim();

          return (
            name === wanted ||
            name.includes(wanted) ||
            wanted.includes(name)
          );
        });
      }

      // Contact was requested but not found.
      if (contactName && !matchedContact) {
        setAgentReply(
          "❌ ما لقيت \"" +
          contactName +
          "\" ضمن Contacts في WASSAL.\n\n" +
          "افتح Contacts وأضف الاسم والرقم، وبعدها جرّب الأمر من جديد."
        );
        setAgentReady(false);
        return;
      }

      // If a contact was found, connect the operation to its stored number.
      if (matchedContact) {
        const contactNumber = normalizeAgentNumber(matchedContact.phone);

        if (!contactNumber) {
          setAgentReply(
            "❌ لقيت " +
            matchedContact.name +
            " لكن ما في رقم هاتف محفوظ لهذا Contact."
          );
          setAgentReady(false);
          return;
        }

        setNumber(contactNumber);

        if (commandMessage) {
          setMessage(commandMessage);
        }

        setAgentReply(
          "👤 Contact: " +
          matchedContact.name +
          "\n" +
          "📱 Number: " +
          contactNumber +
          "\n" +
          "💬 Message: " +
          (commandMessage || "No message") +
          "\n\n" +
          "WASSAL AI جهّز العملية. لم يتم إرسال أي شيء بعد.\n" +
          "اضغط SEND / EXECUTE فقط إذا كنت موافقًا."
        );

        setAgentReady(Boolean(commandMessage));
        return;
      }

      /*
       * No contact name was detected.
       * Keep the existing AI preparation behavior for commands
       * that don't explicitly target a saved contact.
       */
      const response = await fetch("/api/agent", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          message:
            "Prepare this WhatsApp operation for user confirmation. " +
            "DO NOT execute, send, call, book, or perform any external action. " +
            "Only prepare the operation and explain what will happen. " +
            "Selected WhatsApp number: " +
            (number || "not selected") +
            ". Current message: " +
            (message || "empty") +
            ". User command: " +
            agentCommand,
        }),
      });

      const data = await response.json();

      const reply =
        data.reply ||
        data.message ||
        "The AI prepared the request. Please review it before sending.";

      setAgentReply(reply);
      setAgentReady(true);

    } catch (error) {
      console.error(error);

      setAgentReply(
        "AI preparation is ready, but the AI engine is currently unavailable. " +
        "Review the command and message before sending."
      );

      setAgentReady(true);
    } finally {
      setBusy(false);
    }
  };

  const executeAgent = () => {
    if (!agentReady) return;

    if (!number) {
      alert("Choose the WhatsApp number first.");
      return;
    }

    if (!message.trim()) {
      alert("There is no prepared WhatsApp message to send.");
      return;
    }

    openWhatsApp();
  };

  const handleAgentVoice = async () => {
    const SpeechRecognition =
      window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
      alert("Voice recognition is not supported by this browser.");
      return;
    }

    const recognition = new SpeechRecognition();

    recognition.lang = "ar-LB";
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    recognition.onresult = (event) => {
      const text = event.results[0][0].transcript;
      setAgentCommand(text);
    };

    recognition.onerror = (event) => {
      console.error(event.error);
    };

    recognition.start();
  };

  return (
    <div className="module-page">
      <div className="module-header">
        <div>
          <h1>WHATSAPP</h1>
          <p>Messages, contacts and AI-powered WhatsApp actions</p>
        </div>
      </div>

      <div className="module-card">
        <h2>CHOOSE NUMBER</h2>

        <button
          className="primary-btn"
          onClick={() => setChooseOpen(!chooseOpen)}
        >
          {chooseOpen ? "CLOSE" : "CHOOSE NUMBER"}
        </button>

        {chooseOpen && (
          <div
            style={{
              display: "flex",
              gap: "8px",
              flexWrap: "wrap",
              marginTop: "14px",
            }}
          >
            <button className="secondary-btn" onClick={chooseContact}>
              👤 Choose from Contacts
            </button>

            <button
              className="secondary-btn"
              onClick={() => setChooseOpen(false)}
            >
              📱 Enter Number
            </button>
          </div>
        )}

        {(!chooseOpen || number) && (
          <div style={{ marginTop: "14px" }}>
            <input
              value={number}
              onChange={(e) => setNumber(normalizeLebanon(e.target.value))}
              placeholder="Enter Number"
              className="module-input"
              inputMode="tel"
            />
          </div>
        )}

        {number && (
          <div
            style={{
              marginTop: "10px",
              padding: "10px 12px",
              borderRadius: "10px",
              background: "rgba(34,197,94,.10)",
            }}
          >
            Selected: <strong>{number}</strong>
          </div>
        )}
      </div>

      <div className="module-card">
        <h2>WHATSAPP MESSAGE</h2>

        <div
          style={{
            display: "flex",
            gap: "8px",
            alignItems: "stretch",
            flexWrap: "wrap",
          }}
        >
          <textarea
            value={message}
            onChange={(e) => setMessage(e.target.value)}
            placeholder="Write Message..."
            className="module-textarea"
            style={{ flex: "1 1 300px", minHeight: "110px" }}
          />

          <button
            className="primary-btn"
            onClick={openWhatsApp}
            style={{ minWidth: "110px" }}
          >
            SEND
          </button>
        </div>

        <div style={{ marginTop: "12px" }}>
          {!recording ? (
            <button className="secondary-btn" onClick={startRecording}>
              🎙️ Microphone
            </button>
          ) : (
            <button className="danger-btn" onClick={stopRecording}>
              ⏹ Stop Recording
            </button>
          )}
        </div>

        {audioUrl && (
          <audio
            controls
            src={audioUrl}
            style={{ width: "100%", marginTop: "12px" }}
          />
        )}
      </div>

      <div className="module-card">
        <h2>WHATSAPP AGENT AI</h2>

        <p style={{ opacity: 0.75 }}>
          Give the AI a command by text or voice. The AI prepares the operation
          first and waits for your confirmation.
        </p>

        <div
          style={{
            display: "flex",
            gap: "8px",
            alignItems: "stretch",
            flexWrap: "wrap",
            marginTop: "12px",
          }}
        >
          <textarea
            value={agentCommand}
            onChange={(e) => setAgentCommand(e.target.value)}
            placeholder='Example: "اختار مروان واكتبله بدي موعد بكرا الساعة 5"'
            className="module-textarea"
            style={{ flex: "1 1 300px", minHeight: "100px" }}
          />

          <div
            style={{
              display: "flex",
              flexDirection: "column",
              gap: "8px",
            }}
          >
            <button
              className="secondary-btn"
              onClick={handleAgentVoice}
            >
              🎙️ AI VOICE
            </button>

            <button
              className="primary-btn"
              onClick={prepareAgent}
              disabled={busy}
            >
              {busy ? "PREPARING..." : "PREPARE"}
            </button>
          </div>
        </div>

        {agentReply && (
          <div
            style={{
              marginTop: "16px",
              padding: "16px",
              borderRadius: "12px",
              border: "1px solid rgba(127,127,127,.25)",
            }}
          >
            <strong>AI PREPARED OPERATION</strong>

            <div style={{ marginTop: "10px", whiteSpace: "pre-wrap" }}>
              {agentReply}
            </div>

            {agentReady && (
              <button
                className="primary-btn"
                onClick={executeAgent}
                style={{ marginTop: "14px" }}
              >
                SEND / EXECUTE
              </button>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

function ProfilePage() {
