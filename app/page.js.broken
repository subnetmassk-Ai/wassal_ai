"use client";

import { useState, useEffect } from "react";
import { createPortal } from "react-dom";

const navItems = [
  "Dashboard",
  "AI Agent",
  "WhatsApp",
  "Calendar",
  "Location",
  "Files",
  "Web",
  "Tasks",
  "Settings",
  "Admin",
];

const Icon = ({ name, size = 20 }) => {
  const common = {
    width: size,
    height: size,
    viewBox: "0 0 24 24",
    fill: "none",
    stroke: "currentColor",
    strokeWidth: 1.8,
    strokeLinecap: "round",
    strokeLinejoin: "round",
    "aria-hidden": true,
  };

  const paths = {
    Dashboard: (
      <>
        <rect x="3" y="3" width="7" height="7" rx="1.5" />
        <rect x="14" y="3" width="7" height="7" rx="1.5" />
        <rect x="3" y="14" width="7" height="7" rx="1.5" />
        <rect x="14" y="14" width="7" height="7" rx="1.5" />
      </>
    ),

    "AI Agent": (
      <>
        <path d="M12 3v3" />
        <path d="M12 18v3" />
        <path d="M3 12h3" />
        <path d="M18 12h3" />
        <path d="m5.6 5.6 2.1 2.1" />
        <path d="m16.3 16.3 2.1 2.1" />
        <path d="m18.4 5.6-2.1 2.1" />
        <path d="m7.7 16.3-2.1 2.1" />
        <circle cx="12" cy="12" r="4.2" />
      </>
    ),

    Conversations: (
      <>
        <path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.5 8.5 0 0 1-3.5-.8L4 20l1.8-3.7A7.3 7.3 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5Z" />
        <path d="M8 11h.01" />
        <path d="M12 11h.01" />
        <path d="M16 11h.01" />
      </>
    ),

    Contacts: (
      <>
        <circle cx="12" cy="8" r="3" />
        <path d="M5 20c.8-3.2 3.1-5 7-5s6.2 1.8 7 5" />
      </>
    ),

    Calendar: (
      <>
        <rect x="3" y="5" width="18" height="16" rx="2" />
        <path d="M16 3v4M8 3v4M3 10h18" />
        <path d="M8 14h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01" />
      </>
    ),

    Location: (
      <>
        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
        <circle cx="12" cy="10" r="2.5" />
      </>
    ),

    Files: (
      <>
        <path d="M5 3h9l5 5v13H5z" />
        <path d="M14 3v6h5" />
        <path d="M8 13h8M8 17h6" />
      </>
    ),

    Web: (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" />
      </>
    ),

    Tasks: (
      <>
        <rect x="4" y="3" width="16" height="18" rx="2" />
        <path d="m8 9 1.5 1.5L12 8" />
        <path d="M14 9h3M8 14l1.5 1.5L12 13M14 14h3" />
      </>
    ),

    Voice: (
      <>
        <rect x="9" y="3" width="6" height="11" rx="3" />
        <path d="M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6" />
      </>
    ),

    Settings: (
      <>
        <circle cx="12" cy="12" r="3" />
        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.1h-2.6V20a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.6-1H6v-2h.4A1.7 1.7 0 0 0 8 11a1.7 1.7 0 0 0-.3-1.9l-.1-.1 1.8-1.8.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.6v-.1H15V6a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.1v2H21a1.7 1.7 0 0 0-1.6 1Z" />
      </>
    ),

    Admin: (
      <>
        <path d="M12 3 20 6v5c0 5-3.3 8.5-8 10-4.7-1.5-8-5-8-10V6l8-3Z" />
        <path d="m9 12 2 2 4-4" />
      </>
    ),
  };

  if (name === "WhatsApp") {
    return (
      <svg
        width={size}
        height={size}
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          d="M12.04 2A9.94 9.94 0 0 0 3 16.14L2 22l5.99-1.57A10 10 0 1 0 12.04 2Zm0 18.25a8.23 8.23 0 0 1-4.19-1.14l-.3-.18-3.56.93.95-3.47-.2-.32A8.24 8.24 0 1 1 12.04 20.25Zm4.52-6.17c-.25-.13-1.48-.73-1.71-.81-.23-.08-.4-.13-.57.13-.17.25-.65.81-.8.98-.15.17-.3.19-.55.06-.25-.13-1.05-.39-2-1.24-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.39.11-.52.12-.12.25-.3.38-.45.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.37-.78-1.88-.21-.5-.42-.43-.57-.44h-.49c-.17 0-.45.06-.68.32-.23.25-.89.87-.89 2.12s.91 2.46 1.04 2.63c.13.17 1.79 2.73 4.34 3.83.61.26 1.08.41 1.45.52.61.19 1.17.16 1.61.1.49-.07 1.48-.61 1.69-1.2.21-.59.21-1.09.15-1.2-.06-.11-.23-.17-.48-.3Z"
        />
      </svg>
    );
  }

  return <svg {...common}>{paths[name]}</svg>;
};

const icons = {
  Dashboard: "Dashboard",
  "AI Agent": "AI Agent",
  Conversations: "Conversations",
  Contacts: "Contacts",
  WhatsApp: "WhatsApp",
  Calendar: "Calendar",
  Location: "Location",
  Files: "Files",
  Web: "Web",
  Tasks: "Tasks",
  Voice: "Voice",
  Settings: "Settings",
  Admin: "Admin",
};

export default function Home() {
  const [active, setActive] = useState("Dashboard");
  const [agentOn, setAgentOn] = useState(true);
  const [darkMode, setDarkMode] = useState(true);
  const [searchOpen, setSearchOpen] = useState(false);
  const [globalSearch, setGlobalSearch] = useState("");
  const [profileOpen, setProfileOpen] = useState(false);

  return (
    <main className={darkMode ? "app dark-mode" : "app light-mode"}>
      <div className="background-grid" />
      <div className="glow glow-one" />
      <div className="glow glow-two" />

      <aside className="sidebar">
        <div className="brand">
          <div className="brand-logo">W</div>
          <div>
            <strong>WASSAL</strong>
            <span>AI AGENTS</span>
          </div>
        </div>

        <div className="workspace">
          <span>MY WORKSPACE</span>
          <b>⌄</b>
        </div>

        <nav>
          {navItems.map((item) => (
            <button
              key={item}
              className={active === item ? "nav-item active" : "nav-item"}
              onClick={() => setActive(item)}
            >
              <span className="nav-icon"><Icon name={icons[item]} size={19} /></span>
              <span>{item}</span>
            </button>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <div className="trial">
            <small>CURRENT PLAN</small>
            <strong>Free Trial</strong>
            <button>Upgrade →</button>
          </div>

          <div className="account">
            <div className="avatar">M</div>
            <div>
              <strong>My Workspace</strong>
              <small>Administrator</small>
            </div>
          </div>
        </div>
      </aside>

      <section className="content">
        <header className="topbar">
          <div>
            <div className="breadcrumb">WASSAL AI / {active.toUpperCase()}</div>
            <h1>{active}</h1>
            <p>
              {active === "Dashboard"
                ? "Your AI operations at a glance."
                : `Manage your ${active.toLowerCase()} from one place.`}
            </p>
          </div>

          <div className="top-actions">
            <button
              className="top-button"
              type="button"
              title="Search"
              onClick={() => setSearchOpen(!searchOpen)}
            >
              ⌕
            </button>

            <button
              className="top-button"
              type="button"
              title={darkMode ? "Light mode" : "Dark mode"}
              onClick={() => setDarkMode(!darkMode)}
            >
              {darkMode ? "☀" : "☾"}
            </button>

            <div className="profile-wrap">
        <button
          className="profile"
          type="button"
          title="Profile"
          onClick={() => setProfileOpen(!profileOpen)}
        >
          M
        </button>

        {profileOpen && typeof document !== "undefined" && createPortal(
          <div className="profile-menu">
            <div className="profile-menu-head">
              <div className="profile-avatar">M</div>
              <div>
                <strong>WASSAL AI User</strong>
                <span>Account Profile</span>
              </div>
            </div>

            <button
              type="button"
              className="profile-menu-item"
              onClick={() => {
                setActive("My Profile");
                setProfileOpen(false);
              }}
            >
              <span>👤</span>
              <div>
                <b>My Profile</b>
                <small>Manage your profile</small>
              </div>
            </button>

            <button
              type="button"
              className="profile-menu-item"
              onClick={() => {
                setActive("Settings");
                setProfileOpen(false);
              }}
            >
              <span>⚙️</span>
              <div>
                <b>Settings</b>
                <small>Account and preferences</small>
              </div>
            </button>

            <button
              type="button"
              className="profile-menu-item"
              onClick={() => {
                setProfileOpen(false);
                alert("Switch Account");
              }}
            >
              <span>⇄</span>
              <div>
                <b>Switch Account</b>
                <small>Switch account</small>
              </div>
            </button>

            <button
              type="button"
              className="profile-menu-item logout-item"
              onClick={() => {
                setProfileOpen(false);
                alert("Log Out");
              }}
            >
              <span>↪</span>
              <div>
                <b>Log Out</b>
                <small>Sign out of WASSAL AI</small>
              </div>
            </button>
          </div>,
          document.body
        )}
      </div>
          </div>
        </header>

          {searchOpen && (
            <div className="global-search">
              <div className="global-search-box">
                <span>⌕</span>

                <input
                  autoFocus
                  type="text"
                  value={globalSearch}
                  onChange={(e) => setGlobalSearch(e.target.value)}
                  placeholder="Search WASSAL AI..."
                />

                <button
                  type="button"
                  onClick={() => {
                    setGlobalSearch("");
                    setSearchOpen(false);
                  }}
                >
                  ×
                </button>
              </div>

              {globalSearch.trim() && (
                <div className="search-result">
                  <button
                    type="button"
                    onClick={() => {
                      const q = globalSearch.toLowerCase();

                      const routes = [
                        ["conversation", "Conversations"],
                        ["conversations", "Conversations"],
                        ["contact", "Contacts"],
                        ["contacts", "Contacts"],
                        ["whatsapp", "WhatsApp"],
                        ["voice", "Voice"],
                        ["call", "Voice"],
                        ["agent", "AI Agent"],
                        ["assistant", "AI Agent"],
                        ["analytics", "Analytics"],
                        ["billing", "Billing"],
                        ["settings", "Settings"],
                        ["admin", "Admin"]
                      ];

                      const match = routes.find(([word]) => q.includes(word));

                      if (match) {
                        setActive(match[1]);
                        setSearchOpen(false);
                        setGlobalSearch("");
                      }
                    }}
                  >
                    🔎 Open matching section →
                  </button>
                </div>
              )}
            </div>
          )}

        {active === "Dashboard" ? (
          <Dashboard
            agentOn={agentOn}
            setAgentOn={setAgentOn}
            setActive={setActive}
          />
        ) : active === "AI Agent" ? (
          <AIAgentModule />
        ) : active === "Conversations" ? (
          <ConversationsPage />
        ) : active === "WhatsApp" ? (
          <CallChatPage />
        ) : active === "Voice" ? (
          <VoicePage />
        ) : active === "My Profile" ? (
          <ProfilePage />
        ) : active === "Settings" ? (
          <SettingsPage />
        ) : active === "Admin" ? (
          <AdminPage />
        ) : (
          <ModulePage title={active} />
        )}
      </section>

      <style jsx global>{`
        * {
          box-sizing: border-box;
        }

        html,
        body {
          margin: 0;
          padding: 0;
          min-height: 100%;
          background: transparent !important;
          color: #f5f7fb;
          font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
        }

        body {
          overflow-x: hidden;
        }

        button {
          font: inherit;
        }

        .app {
          position: relative;
          min-height: 100vh;
          display: flex;
          overflow: hidden;
          background:
            radial-gradient(circle at 75% 15%, rgba(67, 112, 255, 0.12), transparent 28%),
            radial-gradient(circle at 45% 85%, rgba(0, 214, 255, 0.07), transparent 30%),
            #05070d;
        }

        .background-grid {
          position: fixed;
          inset: 0;
          pointer-events: none;
          opacity: 0.28;
          background-image:
            linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
          background-size: 45px 45px;
          mask-image: linear-gradient(to bottom, black, transparent 90%);
        }

        .glow {
          position: fixed;
          width: 420px;
          height: 420px;
          border-radius: 50%;
          filter: blur(100px);
          pointer-events: none;
          opacity: 0.12;
        }

        .glow-one {
          top: -180px;
          right: 5%;
          background: #346cff;
        }

        .glow-two {
          bottom: -220px;
          left: 35%;
          background: #00bfff;
        }

        .sidebar {
          position: relative;
          z-index: 5;
          width: 255px;
          min-height: 100vh;
          padding: 24px 16px;
          display: flex;
          flex-direction: column;
          border-right: 1px solid rgba(255, 255, 255, 0.08);
          background: rgba(5, 7, 13, 0.35);
          backdrop-filter: blur(18px);
        }

        .brand {
          display: flex;
          align-items: center;
          gap: 11px;
          padding: 4px 10px 28px;
        }

        .brand-logo {
          width: 38px;
          height: 38px;
          display: grid;
          place-items: center;
          border-radius: 11px;
          font-size: 20px;
          font-weight: 900;
          background: linear-gradient(135deg, #5b7cff, #35d8ff);
          box-shadow: 0 0 28px rgba(65, 130, 255, 0.3);
        }

        .brand strong {
          display: block;
          font-size: 17px;
          letter-spacing: 2px;
        }

        .brand span {
          display: block;
          margin-top: 2px;
          color: #71809b;
          font-size: 8px;
          letter-spacing: 2px;
        }

        .workspace {
          margin: 0 5px 18px;
          padding: 11px 12px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          border: 1px solid rgba(255, 255, 255, 0.07);
          border-radius: 10px;
          background: rgba(255, 255, 255, 0.025);
        }

        .workspace span {
          color: #77849a;
          font-size: 9px;
          letter-spacing: 1.4px;
        }

        .workspace b {
          color: #8190a8;
        }

        nav {
          display: flex;
          flex-direction: column;
          gap: 4px;
        }

        .nav-item {
          position: relative;
          width: 100%;
          border: 0;
          padding: 11px 12px;
          display: flex;
          align-items: center;
          gap: 12px;
          border-radius: 9px;
          color: #8290a8;
          background: transparent;
          text-align: left;
          cursor: pointer;
          transition: 0.2s ease;
        }

        .nav-item:hover {
          color: #e8edf7;
          background: rgba(255, 255, 255, 0.045);
        }

        .nav-item.active {
          color: #fff;
          background: linear-gradient(
            90deg,
            rgba(70, 103, 255, 0.22),
            rgba(70, 103, 255, 0.05)
          );
        }

        .nav-item.active::before {
          content: "";
          position: absolute;
          left: -16px;
          width: 3px;
          height: 24px;
          border-radius: 0 5px 5px 0;
          background: #6381ff;
          box-shadow: 0 0 14px #6381ff;
        }

        .nav-icon {
          width: 20px;
          text-align: center;
          color: #71819b;
          font-size: 17px;
        }

        .nav-item.active .nav-icon {
          color: #7c96ff;
        }

        .sidebar-bottom {
          margin-top: auto;
        }

        .trial {
          margin: 16px 4px;
          padding: 14px;
          border: 1px solid rgba(255, 255, 255, 0.07);
          border-radius: 12px;
          background: rgba(255, 255, 255, 0.025);
        }

        .trial small {
          display: block;
          color: #6e7b92;
          font-size: 9px;
          letter-spacing: 1.3px;
        }

        .trial strong {
          display: block;
          margin: 5px 0 10px;
          font-size: 13px;
        }

        .trial button {
          border: 0;
          padding: 0;
          color: #7590ff;
          background: transparent;
          font-size: 11px;
          cursor: pointer;
        }

        .account {
          padding: 14px 8px 4px;
          display: flex;
          align-items: center;
          gap: 10px;
          border-top: 1px solid rgba(255, 255, 255, 0.07);
        }

        .avatar {
          width: 34px;
          height: 34px;
          display: grid;
          place-items: center;
          border-radius: 50%;
          color: white;
          font-weight: 800;
          background: linear-gradient(135deg, #526dff, #27bce9);
        }

        .account strong {
          display: block;
          font-size: 12px;
        }

        .account small {
          color: #68768d;
          font-size: 10px;
        }

        .content {
          position: relative;
          z-index: 2;
          flex: 1;
          min-width: 0;
        }

        .topbar {
          min-height: 110px;
          padding: 27px 42px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          border-bottom: 1px solid rgba(255, 255, 255, 0.06);
          background: rgba(5, 7, 13, 0.12);
          backdrop-filter: blur(8px);
        }

        .breadcrumb {
          margin-bottom: 7px;
          color: #536178;
          font-size: 9px;
          letter-spacing: 1.5px;
        }

        h1 {
          margin: 0;
          font-size: 26px;
          letter-spacing: -0.5px;
        }

        .topbar p {
          margin: 5px 0 0;
          color: #738198;
          font-size: 12px;
        }

        .top-actions {
          display: flex;
          align-items: center;
          gap: 9px;
        }

        .top-button {
          width: 37px;
          height: 37px;
          border: 1px solid rgba(255, 255, 255, 0.08);
          border-radius: 9px;
          color: #8a98af;
          background: rgba(255, 255, 255, 0.025);
          cursor: pointer;
        }

        .profile {
          width: 37px;
          height: 37px;
          display: grid;
          place-items: center;
          border-radius: 50%;
          font-weight: 800;
          background: linear-gradient(135deg, #5069ff, #2bbce8);
        }

        .page {
          max-width: 1450px;
          margin: 0 auto;
          padding: 30px 42px 50px;
        }

        .hero {
          position: relative;
          min-height: 165px;
          padding: 30px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          overflow: hidden;
          border: 1px solid rgba(103, 131, 255, 0.17);
          border-radius: 16px;
          background:
            radial-gradient(circle at 85% 30%, rgba(71, 111, 255, 0.16), transparent 35%),
            linear-gradient(135deg, rgba(25, 35, 67, 0.65), rgba(10, 14, 26, 0.8));
          box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
        }

        .eyebrow {
          color: #718aff;
          font-size: 9px;
          font-weight: 800;
          letter-spacing: 2px;
        }

        .hero h2 {
          margin: 7px 0 7px;
          font-size: 28px;
          letter-spacing: -1px;
        }

        .hero p {
          margin: 0;
          color: #8290a7;
          font-size: 13px;
        }

        .primary {
          border: 0;
          padding: 11px 16px;
          border-radius: 9px;
          color: white;
          font-size: 12px;
          font-weight: 700;
          background: linear-gradient(135deg, #536fff, #328ddf);
          box-shadow: 0 8px 30px rgba(67, 103, 255, 0.2);
          cursor: pointer;
        }

        .stats {
          margin: 18px 0;
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 14px;
        }

        .card {
          border: 1px solid rgba(255, 255, 255, 0.07);
          border-radius: 14px;
          background: rgba(10, 14, 24, 0.72);
          box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
          backdrop-filter: blur(10px);
        }

        .stat {
          min-height: 125px;
          padding: 20px;
        }

        .stat small {
          display: block;
          color: #6f7d94;
          font-size: 11px;
        }

        .stat strong {
          display: block;
          margin-top: 12px;
          font-size: 29px;
          letter-spacing: -1px;
        }

        .stat span {
          color: #4fc6a1;
          font-size: 10px;
        }

        .grid2 {
          margin-bottom: 18px;
          display: grid;
          grid-template-columns: 1.2fr 0.8fr;
          gap: 14px;
        }

        .card-inner {
          padding: 20px;
        }

        .card-head {
          padding: 20px;
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .card-head h3 {
          margin: 0;
          font-size: 14px;
        }

        .card-head p {
          margin: 5px 0 0;
          color: #68768d;
          font-size: 10px;
        }

        .status {
          padding: 5px 8px;
