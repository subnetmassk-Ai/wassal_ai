import { executeTool } from "@/lib/agent-tools";

function normalizeDigits(value) {
  return String(value || "")
    .replace(/[٠-٩]/g, (d) => String("٠١٢٣٤٥٦٧٨٩".indexOf(d)))
    .replace(/[۰-۹]/g, (d) => String("۰۱۲۳۴۵۶۷۸۹".indexOf(d)));
}

function normalizeCalculation(text) {
  let value = normalizeDigits(text).trim();

  const replacements = [
    [/\bزائد\b|plus/gi, "+"],
    [/\bناقص\b|minus/gi, "-"],
    [/\bضرب\b|times/gi, "*"],
    [/\bقسمة\b|divide/gi, "/"],
    [/\bبالمئة\b|percent/gi, "%"],
  ];

  for (const [pattern, replacement] of replacements) {
    value = value.replace(pattern, replacement);
  }

  value = value
    .replace(/×/g, "*")
    .replace(/÷/g, "/")
    .replace(/٪/g, "%")
    .replace(/,/g, ".");

  return value.trim();
}

function isCalculation(text) {
  const normalized = normalizeCalculation(text);

  if (!normalized) return false;

  return (
    /^[0-9+\-*/().%\s]+$/.test(normalized) &&
    /[0-9]/.test(normalized) &&
    /[+\-*/%]/.test(normalized)
  );
}

function detectIntent(message) {
  const text = String(message || "").trim();
  const lower = text.toLowerCase();

  if (isCalculation(text)) {
    return {
      tool: "calculator",
      input: normalizeCalculation(text),
    };
  }

  if (
    /^(كم الساعة|الساعة كم|الوقت|ما هو الوقت|ما الوقت|what time|time)$/i.test(
      text
    )
  ) {
    return {
      tool: "time",
      input: "",
    };
  }

  if (
    lower.startsWith("http://") ||
    lower.startsWith("https://") ||
    lower.includes("google.com") ||
    lower.includes("youtube.com") ||
    lower.includes("facebook.com") ||
    lower.includes("instagram.com")
  ) {
    return {
      tool: "open_url",
      input: text,
    };
  }

  return null;
}

function createRequestId() {
  return `wassal-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
}

function estimateTokens(text) {
  return Math.max(1, Math.ceil(String(text || "").length / 4));
}

function estimateCost(inputTokens, outputTokens) {
  const inputCost = (inputTokens / 1_000_000) * 0.15;
  const outputCost = (outputTokens / 1_000_000) * 0.60;

  return Number((inputCost + outputCost).toFixed(8));
}

function makeLog(data) {
  console.log(
    "[WASSAL_AI_LOG]",
    JSON.stringify({
      timestamp: new Date().toISOString(),
      ...data,
    })
  );
}

async function askOpenAI(message, requestId) {
  const startedAt = Date.now();

  if (!process.env.OPENAI_API_KEY) {
    throw new Error("OPENAI_API_KEY is not configured.");
  }

  const response = await fetch("https://api.openai.com/v1/chat/completions", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,
    },
    body: JSON.stringify({
      model: "gpt-4o-mini",
      messages: [
        {
          role: "system",
          content:
            "You are WASSAL AI, a professional bilingual Arabic and English assistant. Answer clearly and helpfully. When the user speaks Arabic, answer in Arabic.",
        },
        {
          role: "user",
          content: String(message || ""),
        },
      ],
      temperature: 0.3,
    }),
  });

  const data = await response.json();
  const latencyMs = Date.now() - startedAt;

  if (!response.ok) {
    const errorMessage =
      data?.error?.message || `OpenAI request failed (${response.status})`;

    makeLog({
      requestId,
      type: "openai_error",
      provider: "openai",
      model: "gpt-4o-mini",
      latencyMs,
      error: errorMessage,
    });

    throw new Error(errorMessage);
  }

  const reply =
    data?.choices?.[0]?.message?.content?.trim() ||
    "لم يتم الحصول على إجابة.";

  const usage = data?.usage || {};

  const inputTokens =
    Number(usage.prompt_tokens) || estimateTokens(message);

  const outputTokens =
    Number(usage.completion_tokens) || estimateTokens(reply);

  const totalTokens =
    Number(usage.total_tokens) || inputTokens + outputTokens;

  const cost = estimateCost(inputTokens, outputTokens);

  return {
    reply,
    provider: "openai",
    model: "gpt-4o-mini",
    latencyMs,
    usage: {
      inputTokens,
      outputTokens,
      totalTokens,
      estimatedCost: cost,
    },
  };
}

export async function POST(request) {
  const requestId = createRequestId();
  const startedAt = Date.now();

  try {
    const body = await request.json();

    const message =
      body?.message ??
      body?.input ??
      body?.text ??
      "";

    const text = String(message).trim();

    if (!text) {
      return Response.json(
        {
          ok: false,
          error: "Message is required.",
          requestId,
        },
        { status: 400 }
      );
    }

    const intent = detectIntent(text);

    if (intent) {
      const toolStartedAt = Date.now();

      try {
        const result = await executeTool(intent.tool, intent.input);

        const latencyMs = Date.now() - toolStartedAt;

        makeLog({
          requestId,
          type: "tool",
          tool: intent.tool,
          latencyMs,
          success: true,
        });

        return Response.json({
          ok: true,
          requestId,
          source: "tool",
          tool: intent.tool,
          result,
          latencyMs: Date.now() - startedAt,
        });
      } catch (error) {
        makeLog({
          requestId,
          type: "tool_error",
          tool: intent.tool,
          success: false,
          error: error?.message || "Tool execution failed",
        });

        return Response.json(
          {
            ok: false,
            requestId,
            error: error?.message || "Tool execution failed",
          },
          { status: 500 }
        );
      }
    }

    const ai = await askOpenAI(text, requestId);

    makeLog({
      requestId,
      type: "ai",
      provider: ai.provider,
      model: ai.model,
      latencyMs: ai.latencyMs,
      usage: ai.usage,
      success: true,
    });

    return Response.json({
      ok: true,
      requestId,
      source: "ai",
      reply: ai.reply,
      provider: ai.provider,
      model: ai.model,
      usage: ai.usage,
      latencyMs: Date.now() - startedAt,
    });
  } catch (error) {
    const latencyMs = Date.now() - startedAt;

    makeLog({
      requestId,
      type: "request_error",
      latencyMs,
      success: false,
      error: error?.message || "Unknown error",
    });

    return Response.json(
      {
        ok: false,
        requestId,
        error: error?.message || "Internal server error",
      },
      { status: 500 }
    );
  }
}
